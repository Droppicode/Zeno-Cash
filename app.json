{
  "expo": {
    "name": "Zeno Cash",
    "slug": "zeno-cash",
    "version": "1.0.0",
    "entryPoint": "./index.js",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mmn.zenocash",
      "allowBackup": false
    },
    "plugins": [
      "expo-sqlite",
      "./withNotificationListener.js",
      "@react-native-google-signin/google-signin"
    ]
  }
}
