{
  "expo": {
    "name": "Zeno Cash",
    "slug": "zeno-cash",
    "version": "0.1.0",
    "entryPoint": "./index.js",
    "scheme": "zenocash",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmn.zenocash"
    },
    "android": {
      "package": "com.mmn.zenocash",
      "allowBackup": false,
      "versionCode": 18
    },
    "androidStatusBar": {
      "hidden": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "plugins": [
      "expo-sqlite",
      "./withNotificationListener.js",
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ZenoWidget",
              "label": "Zeno Cash",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Atalhos do Zeno Cash"
            }
          ]
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "5ca90b54-3550-47be-b408-42a560db2223"
      }
    },
    "owner": "droppicodes-team"
  }
}
