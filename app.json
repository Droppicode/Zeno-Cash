{
  "expo": {
    "name": "Zeno Cash",
    "slug": "zeno-cash",
    "version": "1.0.0",
    "entryPoint": "./index.js",
    "scheme": "zenocash",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmn.zenocash"
    },
    "android": {
      "package": "com.mmn.zenocash",
      "allowBackup": false
    },
    "androidStatusBar": {
      "hidden": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "plugins": [
      "expo-sqlite",
      "./withNotificationListener.js",
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ZenoWidget",
              "label": "Zeno Cash",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Atalhos do Zeno Cash"
            }
          ]
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker"
    ]
  }
}
